{
  "type": "function",
  "function": {
    "name": "create_patient",
    "description": "Create a new patient record after the caller has confirmed all collected information. Only call this after explicit confirmation from the caller.",
    "parameters": {
      "type": "object",
      "properties": {
        "sex": { "type": "string", "enum": ["Male", "Female", "Other", "Decline to Answer"] },
        "city": { "description": "Patient city", "type": "string" },
        "email": { "description": "Patient email address", "type": "string" },
        "state": { "description": "Two-letter US state abbreviation", "type": "string" },
        "zip_code": { "description": "US ZIP code", "type": "string" },
        "last_name": { "description": "Patient last name", "type": "string" },
        "first_name": { "description": "Patient first name", "type": "string" },
        "phone_number": { "description": "10-digit US phone number", "type": "string" },
        "date_of_birth": { "description": "Patient date of birth in YYYY-MM-DD format", "type": "string" },
        "address_line_1": { "description": "Patient street address", "type": "string" },
        "address_line_2": { "description": "Apartment, suite, or unit", "type": "string" },
        "insurance_provider": { "description": "Insurance company name", "type": "string" },
        "preferred_language": { "description": "Patient preferred language", "type": "string" },
        "insurance_member_id": { "description": "Insurance member or subscriber ID", "type": "string" },
        "emergency_contact_name": { "description": "Emergency contact full name", "type": "string" },
        "emergency_contact_phone": { "description": "Emergency contact US phone number", "type": "string" }
      },
      "required": ["first_name", "last_name", "date_of_birth", "sex", "phone_number", "address_line_1", "city", "state", "zip_code"]
    }
  },
  "server": {
    "url": "https://vapi-patient-registration.vercel.app/patients",
    "timeoutSeconds": 20
  }
}
