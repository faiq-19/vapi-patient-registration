    {
      "parameters": {
        "jsCode": "const query = $('GET /patients').first().json.query || {};\n\nlet patients = $input.all().map(item => item.json);\n\n// Exclude soft-deleted patients\npatients = patients.filter(patient => !patient.deleted_at);\n\n// Optional filters\nif (query.last_name) {\n  const lastName = String(query.last_name).trim().toLowerCase();\n  patients = patients.filter(\n    patient => String(patient.last_name || '').toLowerCase() === lastName\n  );\n}\n\nif (query.date_of_birth) {\n  const dob = String(query.date_of_birth).trim();\n  patients = patients.filter(\n    patient => String(patient.date_of_birth || '') === dob\n  );\n}\n\nif (query.phone_number) {\n  const phone = String(query.phone_number).replace(/\\D/g, '');\n  patients = patients.filter(\n    patient => String(patient.phone_number || '') === phone\n  );\n}\n\nreturn [{\n  json: {\n    data: patients,\n    error: null\n  }\n}];"
      },
      "id": "2649185b-8f7b-4145-922d-96a51987ab73",
