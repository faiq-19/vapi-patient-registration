    {
      "parameters": {
        "jsCode": "const id = $('GET /patients/:id').first().json.params.id;\n\nconst patients = $input.all().map(item => item.json);\n\nconst patient = patients.find(\n  item => item.patient_id === id && !item.deleted_at\n);\n\nif (!patient) {\n  return [{\n    json: {\n      data: null,\n      error: {\n        code: 'NOT_FOUND',\n        message: 'Patient not found'\n      },\n      statusCode: 404\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    data: patient,\n    error: null,\n    statusCode: 200\n  }\n}];"
      },
      "id": "ca0d7ae6-fc14-4ee7-b4a4-e51c03275a69",
