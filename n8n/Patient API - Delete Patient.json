    {
      "parameters": {
        "jsCode": "const request = $('DELETE /patients/:id').first().json;\nconst id = request.params.id;\n\nconst patients = $input.all().map(item => item.json);\n\nconst patient = patients.find(\n  item => item.patient_id === id && !item.deleted_at\n);\n\nif (!patient) {\n  return [{\n    json: {\n      found: false,\n      statusCode: 404,\n      data: null,\n      error: {\n        code: 'NOT_FOUND',\n        message: 'Patient not found'\n      }\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    found: true,\n    patient_id: id,\n    statusCode: 200\n  }\n}];"
      },
